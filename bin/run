#!/usr/bin/env bash
# fanout — primary operation: fan-out concurrent command runner with a hard
# timeout. Compiled ELF binary: `fanout <timeout_s> <cmd1> [cmd2 ...]`.
#
# Usage:
#   bin/run check                    # gate: binary present + executable
#   bin/run <timeout_s> <cmd...>     # run the fanout binary
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${1:-}" = "check" ]; then exec ./bin/check; fi
[ -x fanout ] || { echo "FAIL: fanout binary missing/not executable"; exit 1; }
exec ./fanout "$@"